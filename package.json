{
  "name": "orbital-vision",
  "private": true,
  "version": "0.2.0",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build && node scripts/check-bundle-budget.mjs",
    "check": "pnpm lint && pnpm test && pnpm build",
    "lint": "eslint src --max-warnings=0",
    "preview": "vite preview",
    "release:validate": "node scripts/validate-update-policy.mjs",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "tauri:build:linux": "tauri build --bundles appimage,deb,rpm",
    "tauri:build:macos": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "tauri:build:windows": "tauri build --bundles nsis,msi",
    "tauri:dev": "tauri dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:release": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.334",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "cesium": "1.143.0",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "motion": "^12.43.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.11",
    "satellite.js": "7.1.0",
    "uplot": "^1.6.32",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "cssnano": "^9.0.2",
    "eslint": "^10.8.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.0.4",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.10"
  }
}
